NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-side only. Use only in a trusted local shell for the one-time demo
# account scripts. Never prefix this variable with NEXT_PUBLIC_ or expose it
# to browser code.
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key
DEMO_ADMIN_EMAIL=demo-admin@example.edu
DEMO_ADMIN_PASSWORD=replace-with-a-unique-password-of-at-least-12-characters
